{
  "name": "securechat",
  "version": "1.0.0",
  "description": "SecureChat — run backend + frontend together",
  "scripts": {
    "start":    "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"magenta,cyan\" \"npm start --prefix backend\" \"npm start --prefix frontend\"",
    "backend":  "npm start --prefix backend",
    "frontend": "npm start --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
